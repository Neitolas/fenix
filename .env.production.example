DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_DEBUG=false
# Gere os dois segredos com: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
REPORT_SERVICE_TOKEN=
DJANGO_ALLOWED_HOSTS=fenix.seu-dominio.com.br
DJANGO_TRUST_PROXY_SSL_HEADER=false
DB_ENGINE=mysql
MYSQL_DATABASE=fenix
MYSQL_USER=fenix
MYSQL_PASSWORD=
MYSQL_HOST=db
MYSQL_PORT=3306
REPORT_SERVICE_URL=http://reports:9080
# Ative apenas após confirmar HTTPS em todos os subdomínios e avaliar preload.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
DJANGO_HSTS_SECONDS=3600
